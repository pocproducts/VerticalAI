# ── ARCA Credentials ──────────────────────────────────────────────
# CUIT del estudio contable (representante legal)
ESTUDIO_CUIT="20111111110"
# Clave fiscal del estudio (configurar via metodo seguro)
ESTUDIO_CLAVE_FISCAL=""

# ── Composio (Browser Automation) ─────────────────────────────────
COMPOSIO_API_KEY=""

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS
CORS_ORIGINS="https://app.example.com"

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL="redis://redis:6379/0"

# ── Dev API Key ───────────────────────────────────────────────────
# Leave EMPTY in production
DEV_API_KEY=""

# ── SMTP (Email) ──────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ── Engram Memory ────────────────────────────────────────────────
MEMORY_REDIS_CACHE_URL="redis://redis:6379/0"
MEMORY_REDIS_MAX_MB=25
ENGRAM_JWT_SECRET=""

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_PASSWORD=""
